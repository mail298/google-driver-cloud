# ============================================================
# Database Configuration
# ============================================================
DB_HOST=localhost
DB_PORT=3306
DB_NAME=9drive
DB_USER=root
DB_PASS=your_mysql_password

# ============================================================
# 9drive Gateway Integration Configuration
# ============================================================
GATEWAY_API_URL=http://localhost:4000
GATEWAY_API_KEY=9d_live_your_api_key_here
GATEWAY_MASTER_STORAGE_GB=5120
PORTAL_USERNAME=client
PORTAL_PASSWORD=clientpass

# ============================================================
# Direct Upload CDN Configuration (untuk file berukuran besar)
# ============================================================
# URL endpoint CDN untuk direct upload (bypass PHP proxy).
# File di atas threshold akan langsung di-stream dari browser ke CDN ini.
# Kosongkan jika tidak menggunakan direct upload (semua via PHP).
# UPLOAD_DIRECT_URL=https://up.clouds.wn-cdn.net
UPLOAD_DIRECT_URL=http://upload.domainanda.com

# Ukuran minimum file (dalam bytes) yang akan menggunakan direct upload.
# Default: 10485760 = 10MB. File di bawah threshold tetap melalui PHP /upload.
# Turunkan nilai ini agar lebih banyak file bypass PHP (hindari batasan upload PHP).
UPLOAD_DIRECT_THRESHOLD_BYTES=10485760

# ============================================================
# CDN Subdomain Sharding (untuk gambar/video via img1..imgN)
# ============================================================
# Daftar hostname CDN (dipisahkan koma). URL gambar akan dirotasi antar
# host ini supaya browser bisa membuka lebih banyak koneksi paralel
# (default 6 per-host). Semua host harus CNAME ke tunnel + terdaftar
# sebagai Public Hostname di dashboard Cloudflare.
# Kosongkan untuk fallback ke default: img1-4.wn-cdn.net
CDN_HOSTS=img1.wn-cdn.net,img2.wn-cdn.net,img3.wn-cdn.net,img4.wn-cdn.net

# ============================================================
# Decryption & Google OAuth Credentials
# ============================================================
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your_google_client_secret

# ============================================================
# Admin IP Whitelist Security
# ============================================================
ADMIN_IP_WHITELIST_ENABLED=false
ADMIN_ALLOWED_IPS=127.0.0.1,::1,192.168.3.101

# ============================================================
# Session & Auth Security Configuration
# ============================================================
# Session timeout in minutes (idle = auto logout). 0 = disabled.
SESSION_TIMEOUT_MINUTES=60

# Max failed login attempts before lockout
LOGIN_MAX_ATTEMPTS=5

# Lockout duration in minutes after max attempts reached
LOGIN_LOCKOUT_MINUTES=15

# Enable CSRF token protection on all POST forms (true/false)
CSRF_PROTECTION_ENABLED=true

# Force HTTPS (redirect HTTP to HTTPS). Enable in production only.
FORCE_HTTPS=false

# ============================================================
# Server Port Configuration
# ============================================================
# Port yang digunakan server portal (PHP built-in dev server maupun Docker).
# WAJIB diisi dan harus cocok dengan port server yang berjalan.
# Digunakan oleh spawnFinalize (internal curl) agar upload chunk besar
# dapat di-finalize ke Google Drive tanpa timeout Cloudflare.
# Default dev: php -S 0.0.0.0:7878 -t public
PORTAL_PORT=7878

# Port MySQL yang diekspos ke host (hindari konflik dengan MySQL lokal)
DB_EXPOSE_PORT=3307

# URL Gateway jika dijalankan bersama 9drive dalam satu Docker network
# Ganti dengan nama service 9drive di docker-compose jika digabung
# GATEWAY_API_URL=http://gateway:4000
