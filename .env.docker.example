MYSQL_ROOT_PASSWORD=root
MYSQL_DATABASE=9drive
MYSQL_USER=9drive
MYSQL_PASSWORD=change-this-database-password

FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000
# Google reCAPTCHA v2 Checkbox ("I'm not a robot") - Optional. Leave empty to disable.
VITE_RECAPTCHA_SITE_KEY=
VITE_CDN_SUBDOMAINS=

JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-chars
TOKEN_ENCRYPTION_KEY=change-this-encryption-key-32bytes!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

GOOGLE_CLIENT_ID=your-google-client-id
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback
RECAPTCHA_SECRET_KEY=
ADMIN_ALLOWED_IPS=
TELEGRAM_BOT_TOKEN=token_bot_anda
TELEGRAM_CHAT_ID=chat_id_anda

# Global Proxy Configuration (Optional - routes all backend scraping, API calls, and media streaming through proxy)
# HTTP_PROXY=http://user:password@proxy-ip:port
# HTTPS_PROXY=http://user:password@proxy-ip:port

HTTP_PROXY=
HTTPS_PROXY=

# CDN Multi-Subdomain Streaming (Optional)
# Comma-separated list of CDN subdomain origins pointing to this server.
# Files are routed to a stable CDN subdomain based on fileId hash (cache consistency).
# Cloudflare caches media responses per subdomain edge node.
# Example: https://cdn1.yourdomain.com,https://cdn2.yourdomain.com
CDN_SUBDOMAINS=