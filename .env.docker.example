# ==============================================================================
# 🚀 9DRIVE GOOGLE DRIVE GATEWAY - ENVIRONMENT CONFIGURATION TEMPLATE (.env)
# ==============================================================================
# File ini digunakan sebagai acuan untuk membuat file '.env' di environment
# lokal maupun server produksi (Docker / Coolify / VPS).

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (MySQL 8.4)
# ------------------------------------------------------------------------------
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=9drive
MYSQL_USER=drive9
MYSQL_PASSWORD=change-this-database-password

# DATABASE_URL mengarah ke host MySQL (misal: localhost atau mysql container)
DATABASE_URL=mysql://drive9:change-this-database-password@localhost:3306/9drive?connection_limit=10&connect_timeout=30

# ------------------------------------------------------------------------------
# 2. SERVER & DOMAINS CONFIGURATION
# ------------------------------------------------------------------------------
APP_PORT=4000
FRONTEND_URL=http://localhost:5173
VITE_API_URL=http://localhost:4000

# Service routing FQDN (Coolify / Traefik Proxy - Opsional)
SERVICE_URL_FRONTEND=http://localhost:5173
SERVICE_FQDN_FRONTEND=localhost
SERVICE_URL_BACKEND=http://localhost:4000
SERVICE_FQDN_BACKEND=localhost

# ------------------------------------------------------------------------------
# 3. AUTHENTICATION & SECURITY TOKENS (Minimal 32 Karakter)
# ------------------------------------------------------------------------------
JWT_ACCESS_SECRET=change-this-jwt-secret-at-least-32-characters-long
TOKEN_ENCRYPTION_KEY=change-this-32-byte-encryption-key-for-oauth-tokens!
ACCESS_TOKEN_TTL_SECONDS=3600
REFRESH_TOKEN_TTL_DAYS=30

# ------------------------------------------------------------------------------
# 4. GOOGLE OAUTH & GOOGLE DRIVE API INTEGRATION
# ------------------------------------------------------------------------------
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/connected-accounts/google/callback

# ------------------------------------------------------------------------------
# 5. GOOGLE reCAPTCHA (OPSIONAL)
# ------------------------------------------------------------------------------
# PETUNJUK PENGGUNAAN & FLOW:
# - OPSIONAL: Kosongkan kedua variabel di bawah jika tidak menggunakan reCAPTCHA
#   (misal saat testing lokal). Registrasi akan tetap berjalan tanpa captcha.
# - WAJIB MENGGUNAKAN: Google reCAPTCHA v2 ("I'm not a robot" Checkbox).
#   Jangan gunakan reCAPTCHA v3 / Invisible / Enterprise.
# - Frontend: VITE_RECAPTCHA_SITE_KEY (Google reCAPTCHA v2 Site Key)
# - Backend : RECAPTCHA_SECRET_KEY (Google reCAPTCHA v2 Secret Key)
# ------------------------------------------------------------------------------
VITE_RECAPTCHA_SITE_KEY=
RECAPTCHA_SECRET_KEY=

# ------------------------------------------------------------------------------
# 6. CDN MULTI-SUBDOMAIN & OPTIMIZATION (OPSIONAL)
# ------------------------------------------------------------------------------
VITE_CDN_SUBDOMAINS=
CDN_SUBDOMAINS=

# ------------------------------------------------------------------------------
# 7. NOTIFIKASI TELEGRAM BOT (OPSIONAL)
# ------------------------------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ------------------------------------------------------------------------------
# 8. SMTP EMAIL CONFIGURATION FOR PASSWORD RESET (OPSIONAL)
# ------------------------------------------------------------------------------
# Digunakan untuk mengirim email reset password saat pengguna lupa kata sandi.
# Jika dikosongkan, tautan reset password akan otomatis dicetak ke log backend.
# Pilih salah satu provider di bawah ini (Resend.com atau Gmail App Password):
#
# --- PILIHAN A: RESEND.COM SMTP (REKOMENDASI PRODUKSI) ---
# 1. Buka https://resend.com/api-keys dan buat API Key baru.
# 2. SMTP_USER selalu diisi: resend
# 3. SMTP_PASS diisi dengan Resend API Key Anda (diawali re_...)
# 4. SMTP_FROM diisi dengan domain terverifikasi (atau onboarding@resend.dev untuk testing)
#
# SMTP_HOST=smtp.resend.com
# SMTP_PORT=465
# SMTP_SECURE=true
# SMTP_USER=resend
# SMTP_PASS=re_your_resend_api_key_here
# SMTP_FROM="Drive9 Storage <no-reply@domainanda.com>"
#
# --- PILIHAN B: GMAIL SMTP (APP PASSWORD) ---
# 1. Buka https://myaccount.google.com/apppasswords (pastikan 2FA aktif)
# 2. Buat App Password baru dengan nama 'Drive9'
# 3. Salin 16 karakter password (masukkan ke SMTP_PASS)
# 4. Samakan alamat email di SMTP_USER dan SMTP_FROM agar tidak diblokir Google.
#
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-16-char-app-password
SMTP_FROM="Drive9 Storage <your-email@gmail.com>"

# ------------------------------------------------------------------------------
# 9. SECURITY IP WHITELIST & PROXY (OPSIONAL)
# ------------------------------------------------------------------------------
ADMIN_ALLOWED_IPS=
HTTP_PROXY=
HTTPS_PROXY=

